 src/inspector/node_inspector.gypi     |  2 +-
 tools/v8_gypfiles/d8.gyp              |  2 +-
 tools/v8_gypfiles/v8.gyp              | 60 ++++++++++++++-------------
 tools/v8_gypfiles/v8_debug_helper.gyp |  8 ++--
 5 files changed, 38 insertions(+), 36 deletions(-)

