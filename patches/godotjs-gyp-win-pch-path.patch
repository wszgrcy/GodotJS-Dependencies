-            cflags_c = self.msvs_settings.GetCflagsC(config_name)
-            cflags_cc = self.msvs_settings.GetCflagsCC(config_name)
+            cflags_c = self.PchFlagsRelativeToBuildDir(
+                self.msvs_settings.GetCflagsC(config_name)
+            )
+            cflags_cc = self.PchFlagsRelativeToBuildDir(
+                self.msvs_settings.GetCflagsCC(config_name)
